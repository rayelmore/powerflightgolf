rules_version = '2';
// Triple-G Golf App — paste into Firebase console → Firestore Database → Rules → Publish.
// Anyone can view the app; only people signed in with Google can check in or save changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
